{
  "name": "nextjs-tsx-boilerplate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:strict": "eslint --max-warnings=0 --no-warn-ignored",
    "lint:fix": "eslint --fix",
    "format:write": "prettier --write",
    "format:check": "prettier --check .",
    "format": "pnpm run format:write \"**/*.{js,jsx,ts,tsx,json,md,css,mjs}\" && pnpm run lint:fix . && pnpm run lint:strict \"**/*.{js,jsx,ts,tsx}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-conventional": "^20.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "flatted": ">=3.4.2",
      "fast-uri": ">=3.1.6",
      "minimatch": ">=3.1.3 <4",
      "postcss": ">=8.5.23 <9",
      "picomatch": ">=2.3.2 <3",
      "sharp": ">=0.35.4",
      "nanoid": ">=3.3.18 <4",
      "brace-expansion": ">=1.1.16 <2",
      "js-yaml": ">=4.3.2 <5",
      "browserslist": ">=4.28.7",
      "baseline-browser-mapping": ">=2.11.0",
      "@humanfs/node": ">=0.16.8",
      "@babel/core": ">=7.29.6"
    }
  }
}
