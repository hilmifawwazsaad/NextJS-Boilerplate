# Backend API URL (e.g., http://localhost:3000/api)
NEXT_PUBLIC_API_URL=

# Option 1: JWT
# JWT_SECRET_KEY=

# Option 2: API Key (server-to-server)
# API_SECRET_KEY=

# Option 3: NextAuth
# NEXTAUTH_URL=
# NEXTAUTH_SECRET=

# Option 4: OAuth Providers (use with NextAuth or similar)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=